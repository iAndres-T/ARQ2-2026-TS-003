# Copy to .env to override the local development defaults used by docker-compose.yml.
# All values below are test values for local development only.

# PostgreSQL – one dedicated instance per service (D3). User = service name, database = <name>_db.
IDENTITY_DB_PASSWORD=identity
CONSULTATION_DB_PASSWORD=consultation
TRIAGE_DB_PASSWORD=triage
SCHEDULING_DB_PASSWORD=scheduling
PRESCRIPTION_DB_PASSWORD=prescription
AUDIT_DB_PASSWORD=audit
RECORDING_DB_PASSWORD=recording

# RabbitMQ: user "medconnect" is created by infra/rabbitmq/definitions.json with a FIXED password hash and the user
# name is hard-coded in docker-compose.yml (RABBITMQ_USER is not read). Changing RABBITMQ_PASSWORD alone breaks every
# service: update the hash in definitions.json too (loaded at every broker start) and restart.
RABBITMQ_USER=medconnect
RABBITMQ_PASSWORD=medconnect

# MinIO
MINIO_ROOT_USER=medconnect
MINIO_ROOT_PASSWORD=medconnect-secret

# audit-service runtime role (INSERT/SELECT only); created by infra/audit-db/init
AUDIT_APP_PASSWORD=audit_app

# Shared secret for consultation-service's internal snapshot (care-queue Redis rebuild)
INTERNAL_TOKEN=dev-internal-token

# HMAC secret shared by video-provider (signs) and recording-service (verifies) for the webhook
VIDEO_WEBHOOK_SECRET=dev-video-webhook-secret
# video-provider mock behaviour: "completed" (default) or "failed"
RECORDING_MODE=completed
# Host-reachable MinIO base used in pre-signed download URLs
MINIO_PUBLIC_URL=http://localhost:9000

# Grafana admin (anonymous visitors get Viewer)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Password of the api-gateway dev TLS keystore (generated at start by the gateway-cert service)
GATEWAY_KEYSTORE_PASSWORD=changeit
